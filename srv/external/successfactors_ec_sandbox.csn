  "successfactors_ec_sandbox.FOBusinessUnit": {
   "kind": "entity",
   "@cds.external": true,
   "@cds.persistence.skip": true,
   "@sap.label": "Business Unit",
   "@sap.creatable": "true",
   "@sap.updatable": "true",
   "@sap.upsertable": "true",
   "@sap.deletable": "true",
   "elements": {
    "externalCode": {
     "key": true,
     "type": "cds.String",
     "length": 32,
     "@sap.required": "true",
     "@sap.creatable": "true",
     "@sap.updatable": "true",
     "@sap.upsertable": "true",
     "@sap.visible": "true",
     "@sap.sortable": "true",
     "@sap.filterable": "true",
     "@sap.label": "Business Unit Code",
     "notNull": true
    },
    "startDate": {
     "key": true,
     "type": "cds.Date",
